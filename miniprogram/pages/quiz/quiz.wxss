.quiz-page {
  padding-bottom: 80rpx;
}

.quiz-header {
  display: flex;
  padding-top: 20rpx;
  align-items: flex-start;
  justify-content: space-between;
}

.page-title.small {
  font-size: 48rpx;
}

.score-badge {
  display: flex;
  align-items: baseline;
  color: var(--green);
  font-family: Georgia, serif;
  font-size: 54rpx;
  font-weight: 700;
}

.score-badge text {
  color: var(--muted);
  font-size: 22rpx;
}

.loading {
  margin-top: 60rpx;
  padding: 100rpx 30rpx;
  color: var(--muted);
  text-align: center;
}

.quiz-progress {
  display: flex;
  margin-top: 46rpx;
  align-items: center;
  justify-content: space-between;
  color: var(--muted);
  font-family: Georgia, serif;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.dots {
  display: flex;
  gap: 10rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ddd7cc;
}

.dot.done {
  background: var(--green);
}

.dot.current {
  box-shadow: 0 0 0 6rpx rgba(47, 107, 79, 0.16);
  background: var(--coral);
}

.question-card {
  display: flex;
  min-height: 360rpx;
  margin-top: 28rpx;
  padding: 48rpx 38rpx;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
}

.clue {
  color: var(--coral);
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.meaning {
  margin-top: 28rpx;
  font-family: Georgia, "Songti SC", serif;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.4;
}

.phonetic {
  margin-top: 18rpx;
  color: var(--muted);
  font-family: Georgia, serif;
  font-size: 28rpx;
}

.length-hint {
  margin-top: 34rpx;
  color: #9aa39e;
  font-size: 21rpx;
}

.answer-area {
  margin-top: 24rpx;
  padding: 28rpx 30rpx;
  border: 2rpx solid transparent;
  border-radius: 26rpx;
  background: var(--card);
  box-shadow: 0 12rpx 34rpx rgba(54, 66, 58, 0.07);
}

.answer-area.correct {
  border-color: var(--green);
}

.answer-area.wrong {
  border-color: var(--coral);
}

.answer-input {
  width: 100%;
  height: 72rpx;
  font-family: Georgia, serif;
  font-size: 36rpx;
  letter-spacing: 2rpx;
}

.feedback {
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(31, 42, 36, 0.08);
  font-size: 25rpx;
}

.feedback-correct {
  color: var(--green);
}

.feedback-wrong {
  color: var(--coral);
}

.full {
  width: 100%;
}

.submit {
  margin-top: 24rpx;
}

.result-panel {
  display: flex;
  margin-top: 70rpx;
  padding: 60rpx 40rpx;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.result-kicker {
  color: var(--green);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.result-score {
  margin-top: 24rpx;
  color: var(--green);
  font-family: Georgia, serif;
  font-size: 160rpx;
  font-weight: 700;
  line-height: 1;
}

.result-copy {
  max-width: 500rpx;
  margin: 24rpx 0 44rpx;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.7;
}

