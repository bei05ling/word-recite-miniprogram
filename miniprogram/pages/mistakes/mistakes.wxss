.page-heading {
  padding-top: 20rpx;
}

.queue-note {
  display: block;
  margin-top: 24rpx;
  color: var(--coral);
  font-size: 24rpx;
}

.round-finished {
  display: flex;
  margin-top: 54rpx;
  padding: 64rpx 40rpx;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.round-mark {
  display: flex;
  width: 118rpx;
  height: 118rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #fff;
  background: var(--green);
  font-size: 54rpx;
}

.round-title {
  margin-top: 30rpx;
  font-family: Georgia, "Songti SC", serif;
  font-size: 40rpx;
  font-weight: 700;
}

.round-copy {
  margin: 18rpx 0 38rpx;
  color: var(--muted);
  font-size: 25rpx;
  line-height: 1.7;
}

.full {
  width: 100%;
}

.review-count {
  margin-top: 44rpx;
  color: var(--muted);
  font-family: Georgia, serif;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.review-card {
  display: flex;
  min-height: 520rpx;
  margin-top: 18rpx;
  padding: 52rpx 40rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  text-align: center;
}

.review-word {
  font-family: Georgia, serif;
  font-size: 88rpx;
  font-weight: 700;
}

.review-phonetic {
  margin-top: 18rpx;
  color: var(--muted);
  font-family: Georgia, serif;
  font-size: 28rpx;
}

.reveal-hint {
  margin-top: 64rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid rgba(31, 42, 36, 0.08);
  color: #9aa39e;
  font-size: 23rpx;
}

.review-answer {
  display: flex;
  margin-top: 54rpx;
  padding-top: 34rpx;
  flex-direction: column;
  gap: 20rpx;
  border-top: 1rpx solid rgba(31, 42, 36, 0.08);
}

.review-meaning {
  color: var(--green);
  font-family: "Songti SC", Georgia, serif;
  font-size: 36rpx;
  font-weight: 700;
}

.review-level {
  color: var(--muted);
  font-size: 22rpx;
}

.answer-actions {
  display: flex;
  margin-top: 22rpx;
  gap: 16rpx;
}

.answer-button {
  display: flex;
  height: 92rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.answer-button.wrong {
  color: var(--coral);
  background: #f8e4df;
}

.answer-button.right {
  color: #fff;
  background: var(--green);
}

.reveal-button {
  margin-top: 22rpx;
}

