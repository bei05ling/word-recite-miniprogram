.achievements-page {
  padding-bottom: 80rpx;
}

.achievement-hero {
  padding: 38rpx 34rpx 32rpx;
  border-radius: 34rpx;
  color: #fffdf7;
  background:
    radial-gradient(circle at 90% 0%, rgba(215, 168, 68, 0.28), transparent 34%),
    #244d3c;
  box-shadow: 0 22rpx 52rpx rgba(36, 77, 60, 0.2);
}

.level-label {
  display: block;
  color: rgba(255, 253, 247, 0.62);
  font-size: 18rpx;
}

.level-name {
  display: block;
  margin-top: 7rpx;
  color: #f1d391;
  font-family: Georgia, "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 28rpx;
  font-family: Georgia, "Songti SC", serif;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.3;
}

.hero-title-line {
  display: block;
}

.hero-progress,
.level-progress {
  margin-top: 34rpx;
}

.hero-progress-copy,
.level-progress-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  color: rgba(255, 253, 247, 0.68);
  font-size: 18rpx;
}

.progress-count {
  font-family: Georgia, serif;
  font-size: 34rpx;
  font-weight: 700;
}

.progress-label {
  color: rgba(255, 253, 247, 0.66);
  font-size: 19rpx;
}

.hero-track {
  height: 8rpx;
  margin-top: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
}

.hero-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #d7a844;
}

.badge-summary {
  display: flex;
  margin-top: 22rpx;
  padding-top: 20rpx;
  align-items: baseline;
  justify-content: space-between;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
  color: rgba(255, 253, 247, 0.64);
  font-size: 18rpx;
}

.badge-summary text:first-child {
  color: #fffdf7;
  font-family: Georgia, serif;
  font-size: 28rpx;
  font-weight: 700;
}

.achievement-loading {
  margin-top: 22rpx;
  padding: 90rpx 30rpx;
  color: var(--muted);
  text-align: center;
}

.next-achievement {
  display: flex;
  margin-top: 18rpx;
  padding: 26rpx;
  align-items: center;
  gap: 20rpx;
  background: #fff8e8;
}

.next-mark {
  display: flex;
  width: 74rpx;
  height: 74rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  color: #fff;
  background: var(--coral);
  font-family: "Songti SC", Georgia, serif;
  font-size: 28rpx;
  font-weight: 700;
}

.next-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.next-label {
  color: var(--coral);
  font-size: 18rpx;
  font-weight: 600;
}

.next-title {
  margin-top: 7rpx;
  font-family: Georgia, "Songti SC", serif;
  font-size: 28rpx;
  font-weight: 700;
}

.next-desc {
  margin-top: 7rpx;
  color: var(--muted);
  font-size: 19rpx;
}

.achievement-list {
  margin-top: 30rpx;
}

.section-heading {
  display: flex;
  margin-top: 42rpx;
  align-items: baseline;
  justify-content: space-between;
}

.section-title {
  font-family: Georgia, "Songti SC", serif;
  font-size: 33rpx;
  font-weight: 700;
}

.section-note {
  color: var(--muted);
  font-size: 19rpx;
}

.activity-panel {
  margin-top: 16rpx;
  padding: 26rpx 24rpx 22rpx;
}

.activity-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
}

.activity-day {
  display: flex;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  color: var(--muted);
  background: #eae5dc;
  font-family: Georgia, serif;
  font-size: 17rpx;
}

.activity-day.active {
  color: #fff;
  background: var(--green);
  font-weight: 700;
}

.activity-legend {
  display: flex;
  margin-top: 20rpx;
  justify-content: flex-end;
  gap: 18rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 7rpx;
  color: var(--muted);
  font-size: 17rpx;
}

.legend-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 4rpx;
  background: #eae5dc;
}

.legend-dot.active {
  background: var(--green);
}

.achievement-row {
  display: flex;
  padding: 24rpx 0;
  gap: 20rpx;
  border-bottom: 1rpx solid rgba(31, 42, 36, 0.08);
}

.achievement-mark {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  color: #fff;
  background: #9ca6a0;
  font-family: "Songti SC", Georgia, serif;
  font-size: 27rpx;
  font-weight: 700;
}

.achievement-row.unlocked .achievement-mark {
  background: var(--green);
}

.achievement-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.achievement-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 14rpx;
}

.achievement-title {
  font-family: Georgia, "Songti SC", serif;
  font-size: 28rpx;
  font-weight: 700;
}

.achievement-state {
  flex: none;
  color: var(--coral);
  font-size: 18rpx;
  font-weight: 600;
}

.achievement-desc {
  margin-top: 7rpx;
  color: var(--muted);
  font-size: 19rpx;
}

.achievement-track {
  height: 6rpx;
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e6e1d8;
}

.achievement-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--green);
}

.milestone-strip {
  display: flex;
  margin-top: 28rpx;
  padding: 24rpx;
  align-items: center;
}

.milestone {
  display: flex;
  flex: 1;
  align-items: center;
  flex-direction: column;
}

.milestone-value {
  font-family: Georgia, serif;
  font-size: 38rpx;
  font-weight: 700;
}

.milestone-label {
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 18rpx;
}

.milestone-divider {
  width: 1rpx;
  height: 50rpx;
  background: rgba(31, 42, 36, 0.1);
}

.achievement-actions {
  display: grid;
  margin-top: 20rpx;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.achievement-actions button {
  width: 100%;
  min-height: 86rpx;
}
