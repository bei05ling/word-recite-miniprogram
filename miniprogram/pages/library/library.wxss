.library-page {
  padding-bottom: 80rpx;
}

.library-hero {
  padding: 34rpx 30rpx;
  border: 1rpx solid rgba(31, 42, 36, 0.08);
  border-radius: 36rpx;
  background:
    linear-gradient(135deg, rgba(219, 233, 223, 0.7), rgba(255, 253, 247, 0.95)),
    var(--card);
  box-shadow: 0 22rpx 52rpx rgba(54, 66, 58, 0.08);
}

.library-heading {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.library-number {
  color: rgba(47, 107, 79, 0.18);
  font-family: Georgia, serif;
  font-size: 118rpx;
  font-weight: 700;
  line-height: 0.8;
}

.library-title {
  margin-top: 8rpx;
  font-family: Georgia, "Songti SC", serif;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.18;
}

.library-summary {
  display: flex;
  margin-top: 28rpx;
  padding-top: 22rpx;
  justify-content: space-between;
  border-top: 1rpx solid rgba(31, 42, 36, 0.08);
  color: var(--muted);
  font-size: 20rpx;
}

.search-entry {
  display: flex;
  width: 100%;
  height: 82rpx;
  margin-top: 26rpx;
  padding: 0 22rpx;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  border: 1rpx solid rgba(47, 107, 79, 0.13);
  border-radius: 22rpx;
  color: var(--muted);
  background: rgba(255, 253, 247, 0.88);
  font-size: 22rpx;
  text-align: left;
}

.search-entry-action {
  color: var(--green);
  font-weight: 600;
}

.library-loading {
  margin-top: 24rpx;
  padding: 90rpx 30rpx;
  color: var(--muted);
  text-align: center;
}

.daily-word {
  display: flex;
  width: 100%;
  margin-top: 20rpx;
  padding: 28rpx 28rpx 24rpx;
  flex-direction: column;
  box-sizing: border-box;
  border-radius: 30rpx;
  color: #fffdf7;
  background:
    radial-gradient(circle at 90% 10%, rgba(215, 168, 68, 0.35), transparent 36%),
    #244d3c;
  text-align: left;
}

.daily-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: rgba(255, 253, 247, 0.68);
  font-size: 19rpx;
}

.daily-main {
  display: flex;
  margin-top: 24rpx;
  align-items: center;
  gap: 24rpx;
}

.daily-letter {
  color: rgba(245, 239, 226, 0.28);
  font-family: Georgia, serif;
  font-size: 130rpx;
  font-weight: 700;
  line-height: 0.85;
}

.daily-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.daily-word-text {
  font-family: Georgia, serif;
  font-size: 50rpx;
  font-weight: 700;
  word-break: break-all;
}

.daily-phonetic {
  margin-top: 4rpx;
  color: rgba(255, 253, 247, 0.65);
  font-family: Georgia, serif;
  font-size: 22rpx;
}

.daily-meaning {
  margin-top: 14rpx;
  color: rgba(255, 253, 247, 0.84);
  font-size: 23rpx;
}

.daily-action {
  align-self: flex-end;
  margin-top: 22rpx;
  color: rgba(255, 253, 247, 0.68);
  font-size: 19rpx;
}

.library-section-heading {
  display: flex;
  margin-top: 44rpx;
  align-items: baseline;
  justify-content: space-between;
}

.section-title {
  font-family: Georgia, "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 700;
}

.section-note {
  color: var(--muted);
  font-size: 19rpx;
}

.shelf-list {
  margin-top: 8rpx;
}

.shelf-row {
  display: flex;
  width: 100%;
  padding: 28rpx 0;
  align-items: flex-start;
  gap: 18rpx;
  border-bottom: 1rpx solid rgba(31, 42, 36, 0.1);
  text-align: left;
}

.shelf-row:last-child {
  border-bottom: 0;
}

.shelf-index {
  padding-top: 3rpx;
  color: #9aa39e;
  font-family: Georgia, serif;
  font-size: 20rpx;
}

.shelf-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.shelf-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.shelf-title {
  color: var(--ink);
  font-family: Georgia, "Songti SC", serif;
  font-size: 31rpx;
  font-weight: 700;
}

.shelf-level {
  font-size: 17rpx;
  font-weight: 700;
}

.shelf-subtitle {
  margin-top: 7rpx;
  color: var(--coral);
  font-size: 19rpx;
}

.shelf-description {
  margin-top: 9rpx;
  padding-right: 16rpx;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 1.5;
}

.shelf-progress-row {
  display: flex;
  margin-top: 16rpx;
  align-items: center;
  gap: 12rpx;
  color: var(--muted);
  font-family: Georgia, serif;
  font-size: 17rpx;
}

.shelf-progress-track {
  height: 6rpx;
  flex: 1;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e6e1d7;
}

.shelf-progress-fill {
  height: 100%;
  border-radius: 999rpx;
}

.shelf-action {
  display: flex;
  width: 74rpx;
  height: 58rpx;
  margin-top: 8rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: #fff;
  font-size: 19rpx;
  font-weight: 600;
}

.title-line {
  display: block;
}
