.study-page {
  display: flex;
  flex-direction: column;
}

.study-header {
  display: flex;
  padding-top: 20rpx;
  align-items: flex-start;
  justify-content: space-between;
}

.study-title {
  margin-top: 8rpx;
  font-family: Georgia, "Songti SC", serif;
  font-size: 46rpx;
  font-weight: 700;
}

.close-button {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(31, 42, 36, 0.12);
  border-radius: 50%;
  color: var(--muted);
  background: var(--card);
  font-family: Georgia, serif;
  font-size: 42rpx;
  font-weight: 300;
}

.loading {
  margin-top: 60rpx;
  padding: 100rpx 32rpx;
  color: var(--muted);
  text-align: center;
}

.progress-track {
  height: 8rpx;
  margin: 34rpx 0 28rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #e5e0d6;
}

.progress-fill {
  height: 100%;
  border-radius: 8rpx;
  background: var(--green);
  transition: width 320ms ease;
}

.study-tools {
  display: flex;
  margin-top: 30rpx;
  align-items: center;
  justify-content: space-between;
}

.skip-button {
  padding: 18rpx 20rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.detail-link {
  padding: 18rpx 8rpx;
  color: var(--green);
  font-size: 22rpx;
  font-weight: 600;
}

.nav-row {
  display: flex;
  margin-top: 24rpx;
  gap: 16rpx;
}

.nav-button {
  display: flex;
  height: 92rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  color: var(--green);
  background: var(--green-soft);
  font-size: 26rpx;
  font-weight: 600;
}

.nav-button.primary {
  color: #fff;
  background: var(--green);
}

.nav-button[disabled] {
  opacity: 0.35;
}

