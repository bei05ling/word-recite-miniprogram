.home {
  overflow: hidden;
}

.hero-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-top: 24rpx;
}

.avatar-button {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(31, 42, 36, 0.12);
  border-radius: 50%;
  color: var(--green);
  background: var(--card);
  font-family: "Songti SC", serif;
  font-size: 30rpx;
  font-weight: 700;
}

.loading-card {
  margin-top: 56rpx;
  padding: 80rpx 36rpx;
  color: var(--muted);
  text-align: center;
}

.today-card {
  display: flex;
  min-height: 330rpx;
  margin-top: 54rpx;
  padding: 42rpx 36rpx;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  background:
    linear-gradient(135deg, rgba(219, 233, 223, 0.72), rgba(255, 253, 247, 0.92)),
    var(--card);
}

.today-copy {
  display: flex;
  max-width: 340rpx;
  flex-direction: column;
}

.book-level {
  align-self: flex-start;
  padding: 8rpx 14rpx;
  border-radius: 10rpx;
  color: var(--green);
  background: rgba(47, 107, 79, 0.1);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.book-name {
  margin-top: 24rpx;
  font-family: Georgia, "Songti SC", serif;
  font-size: 42rpx;
  font-weight: 700;
}

.book-subtitle {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.streak-pill {
  display: flex;
  margin-top: 34rpx;
  align-items: center;
  gap: 10rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.streak-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--coral);
}

.metric-row {
  display: flex;
  margin-top: 24rpx;
  gap: 16rpx;
}

.metric {
  display: flex;
  min-width: 0;
  padding: 28rpx 24rpx;
  flex: 1;
  flex-direction: column;
}

.metric-value {
  font-family: Georgia, serif;
  font-size: 42rpx;
  font-weight: 700;
}

.metric-label {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.metric-accent {
  border-radius: 28rpx;
  color: #fff;
  background: var(--green);
  box-shadow: 0 18rpx 40rpx rgba(47, 107, 79, 0.22);
}

.metric-accent .metric-label {
  color: rgba(255, 255, 255, 0.7);
}

.start-button {
  width: 100%;
  margin-top: 28rpx;
  justify-content: space-between;
  padding: 0 38rpx;
  box-sizing: border-box;
}

.button-arrow {
  font-size: 40rpx;
}

.quick-grid {
  display: grid;
  margin-top: 44rpx;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.quick-card {
  display: flex;
  min-height: 220rpx;
  padding: 28rpx;
  flex-direction: column;
  align-items: flex-start;
  box-sizing: border-box;
  text-align: left;
}

.quick-card.wide {
  min-height: 190rpx;
  grid-column: 1 / -1;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.quick-index {
  color: var(--coral);
  font-family: Georgia, serif;
  font-size: 20rpx;
  font-weight: 700;
}

.quick-title {
  margin-top: 20rpx;
  font-family: Georgia, "Songti SC", serif;
  font-size: 32rpx;
  font-weight: 700;
}

.quick-title.block {
  display: block;
}

.quick-desc {
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 21rpx;
  line-height: 1.45;
}

.mini-chart {
  display: flex;
  width: 140rpx;
  height: 100rpx;
  align-items: flex-end;
  justify-content: flex-end;
  gap: 10rpx;
}

.chart-bar {
  width: 18rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: var(--green);
}

.h1 {
  height: 34%;
  opacity: 0.35;
}

.h2 {
  height: 58%;
  opacity: 0.55;
}

.h3 {
  height: 46%;
  opacity: 0.75;
}

.h4 {
  height: 92%;
}

