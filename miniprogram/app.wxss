page {
  --ink: #1f2a24;
  --muted: #708078;
  --paper: #f7f3ea;
  --card: #fffdf7;
  --green: #2f6b4f;
  --green-soft: #dbe9df;
  --coral: #e8795e;
  --gold: #d7a844;
  min-height: 100%;
  background: var(--paper);
  color: var(--ink);
  font-family: "PingFang SC", "Helvetica Neue", sans-serif;
}

button {
  margin: 0;
  padding: 0;
  line-height: inherit;
  background: transparent;
  border: 0;
  border-radius: 0;
  font-size: inherit;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  padding: 32rpx 32rpx 64rpx;
  box-sizing: border-box;
}

.eyebrow {
  color: var(--green);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.page-title {
  margin-top: 12rpx;
  font-family: Georgia, "Songti SC", serif;
  font-size: 58rpx;
  font-weight: 700;
  line-height: 1.15;
}

.page-title .title-line {
  display: block;
}

.surface {
  border: 1rpx solid rgba(31, 42, 36, 0.08);
  border-radius: 32rpx;
  background: var(--card);
  box-shadow: 0 18rpx 50rpx rgba(54, 66, 58, 0.08);
}

.primary-button,
.secondary-button {
  display: flex;
  min-height: 96rpx;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.primary-button {
  color: #fff;
  background: var(--green);
  box-shadow: 0 14rpx 30rpx rgba(47, 107, 79, 0.22);
}

.secondary-button {
  color: var(--green);
  background: var(--green-soft);
}

.section-title {
  font-family: Georgia, "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 700;
}

.muted {
  color: var(--muted);
}

