.ring-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}

.ring {
  display: flex;
  width: 216rpx;
  height: 216rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.ring-core {
  display: flex;
  width: 164rpx;
  height: 164rpx;
  align-items: baseline;
  justify-content: center;
  border-radius: 50%;
  background: #fffdf7;
  box-shadow: inset 0 0 0 1rpx rgba(31, 42, 36, 0.06);
}

.ring-value {
  align-self: center;
  font-family: Georgia, serif;
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1;
}

.ring-symbol {
  margin-top: 52rpx;
  color: #708078;
  font-size: 24rpx;
}

.ring-caption {
  color: #708078;
  font-size: 24rpx;
}

