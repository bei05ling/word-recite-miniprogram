.card-scene {
  width: 100%;
  height: 820rpx;
  perspective: 1800rpx;
}

.word-card {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform 540ms cubic-bezier(0.2, 0.72, 0.24, 1);
}

.word-card.is-flipped {
  transform: rotateY(180deg);
}

.card-face {
  position: absolute;
  inset: 0;
  display: flex;
  padding: 38rpx;
  flex-direction: column;
  box-sizing: border-box;
  border-radius: 38rpx;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  box-shadow: 0 26rpx 70rpx rgba(54, 66, 58, 0.13);
}

.card-front {
  border: 1rpx solid rgba(31, 42, 36, 0.08);
  background:
    radial-gradient(circle at 85% 12%, rgba(232, 121, 94, 0.13), transparent 28%),
    #fffdf7;
}

.card-back {
  color: #fff;
  background:
    radial-gradient(circle at 15% 90%, rgba(232, 121, 94, 0.28), transparent 38%),
    #224f3c;
  transform: rotateY(180deg);
}

.card-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-label {
  color: #2f6b4f;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.card-label.light {
  color: rgba(255, 255, 255, 0.62);
}

.flip-hint {
  color: #8a958f;
  font-size: 21rpx;
}

.flip-hint.light {
  color: rgba(255, 255, 255, 0.55);
}

.word-main,
.meaning-main {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
}

.word-text {
  font-family: Georgia, serif;
  font-size: 100rpx;
  font-weight: 700;
  line-height: 1.1;
  word-break: break-all;
}

.phonetic {
  margin-top: 20rpx;
  color: #708078;
  font-family: Georgia, serif;
  font-size: 30rpx;
}

.syllable-row {
  display: flex;
  margin-top: 48rpx;
  flex-wrap: wrap;
  gap: 12rpx;
}

.syllable {
  padding: 12rpx 20rpx;
  border: 1rpx solid rgba(47, 107, 79, 0.16);
  border-radius: 20rpx;
  color: #2f6b4f;
  background: #edf4ef;
  font-family: Georgia, serif;
  font-size: 26rpx;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.footer-note {
  color: #8a958f;
  font-size: 21rpx;
}

.footer-arrow {
  color: #e8795e;
  font-size: 36rpx;
}

.meaning-text {
  font-family: "Songti SC", Georgia, serif;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.45;
}

.example-block {
  display: flex;
  margin-top: 52rpx;
  padding-top: 32rpx;
  flex-direction: column;
  gap: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.16);
}

.example {
  color: rgba(255, 255, 255, 0.9);
  font-family: Georgia, serif;
  font-size: 30rpx;
  line-height: 1.6;
}

.translation {
  color: rgba(255, 255, 255, 0.56);
  font-size: 23rpx;
  line-height: 1.6;
}

.mastery-button {
  width: 100%;
  padding: 26rpx 0;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.08);
  font-size: 26rpx;
  font-weight: 600;
}

.mastery-button.active {
  border-color: transparent;
  color: #224f3c;
  background: #d9eadf;
}

