<view class="empty-state">
  <view class="empty-mark">
    <view class="empty-line short"></view>
    <view class="empty-line"></view>
    <view class="empty-line medium"></view>
  </view>
  <text class="empty-title">{{title}}</text>
  <text class="empty-description">{{description}}</text>
  <button wx:if="{{actionText}}" class="empty-action" bindtap="handleAction">
    {{actionText}}
  </button>
</view>

