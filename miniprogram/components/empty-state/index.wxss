.empty-state {
  display: flex;
  padding: 72rpx 40rpx;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-mark {
  display: flex;
  width: 132rpx;
  height: 132rpx;
  margin-bottom: 32rpx;
  padding: 28rpx;
  flex-direction: column;
  justify-content: center;
  gap: 12rpx;
  box-sizing: border-box;
  border-radius: 36rpx;
  background: #dbe9df;
  transform: rotate(-4deg);
}

.empty-line {
  width: 100%;
  height: 8rpx;
  border-radius: 8rpx;
  background: #2f6b4f;
}

.empty-line.short {
  width: 52%;
}

.empty-line.medium {
  width: 76%;
}

.empty-title {
  font-family: Georgia, "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 700;
}

.empty-description {
  max-width: 480rpx;
  margin-top: 16rpx;
  color: #708078;
  font-size: 26rpx;
  line-height: 1.7;
}

.empty-action {
  margin-top: 36rpx;
  padding: 22rpx 34rpx;
  border-radius: 24rpx;
  color: #2f6b4f;
  background: #dbe9df;
  font-size: 26rpx;
  font-weight: 600;
}

